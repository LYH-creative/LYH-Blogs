*.js linguist-language=astro

# 统一换行符：仓库内一律存 LF，检出时也用 LF
# 不加这行的话，在 CRLF 环境下编辑会产生"整文件被改"的假 diff 噪音
* text=auto eol=lf

# 二进制文件不做换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.pdf  binary
*.zip  binary
